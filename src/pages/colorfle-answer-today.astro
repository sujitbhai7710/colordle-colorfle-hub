---
import Layout from '../layouts/Layout.astro';

const today = new Date().toISOString().split('T')[0];
const apiUrl = import.meta.env.PUBLIC_API_URL || '';
---

<Layout title="Colorfle Answer Today" description="Today's Colorfle answer revealed. Get the daily normal and hard mode color combinations with spoiler protection.">
  <section class="answer-page">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb animate-fade-in-up" aria-label="Breadcrumb">
        <a href="/" class="breadcrumb-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          Home
        </a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">Colorfle Today</span>
      </nav>

      <!-- Title -->
      <div class="page-header animate-fade-in-up delay-1">
        <h1 class="page-title">
          Colorfle Answer<br/><span class="gradient-text">Today</span>
        </h1>
        <p class="page-date" id="dateDisplay"></p>
      </div>

      <!-- Main Answer Card -->
      <div class="answer-card glass-card animate-fade-in-up delay-2" id="answerCard">
        <!-- Loading State -->
        <div class="loading-state" id="loadingState">
          <div class="spinner"></div>
          <p>Loading today's answer...</p>
        </div>

        <!-- Answer State -->
        <div class="answer-state hidden" id="answerState">
          <div class="answer-day" id="dayNumber"></div>

          <!-- Spoiler Overlay -->
          <div class="spoiler-overlay" id="spoilerOverlay">
            <div class="spoiler-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </div>
            <span class="spoiler-text">Click to Reveal Answer</span>
          </div>

          <div class="answer-content blurred" id="answerContent">
            <!-- Mode Toggle -->
            <div class="mode-toggle">
              <button class="mode-btn active" id="normalBtn">Normal</button>
              <button class="mode-btn" id="hardBtn">Hard</button>
            </div>

            <!-- Normal Mode Blocks -->
            <div class="blocks-section" id="normalSection"></div>

            <!-- Hard Mode Blocks -->
            <div class="blocks-section hidden" id="hardSection"></div>

            <!-- Blend Preview -->
            <div class="blend-section" id="blendSection"></div>
          </div>

          <div class="answer-actions">
            <a href="https://colorfle.com/" target="_blank" rel="noopener" class="btn-primary">
              Play Colorfle
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
            </a>
            <a href="/colorfle-archive" class="btn-secondary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              View Archive
            </a>
          </div>
        </div>

        <!-- Error State -->
        <div class="error-state hidden" id="errorState">
          <div class="error-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          </div>
          <p>Could not load today's answer. Please try again later.</p>
        </div>
      </div>

      <!-- Recent Answers -->
      <div class="recent-section animate-fade-in-up delay-3">
        <h3 class="recent-title">Recent Answers</h3>
        <div class="recent-list" id="recentList">
          <div class="skeleton" style="height: 56px; margin-bottom: 8px;"></div>
          <div class="skeleton" style="height: 56px; margin-bottom: 8px;"></div>
          <div class="skeleton" style="height: 56px;"></div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .answer-page {
    padding: 40px 0 96px;
  }

  /* ── Breadcrumb ── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    font-size: 0.85rem;
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text-muted);
    transition: color var(--duration-fast) ease;
  }

  .breadcrumb-link:hover { color: var(--accent-light); }
  .breadcrumb-sep { color: var(--text-muted); opacity: 0.5; }
  .breadcrumb-current { color: var(--text-secondary); font-weight: 500; }

  /* ── Page Header ── */
  .page-header { margin-bottom: 40px; }

  .page-title {
    font-size: 3rem;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }

  .page-date {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  /* ── Answer Card ── */
  .answer-card {
    padding: 48px;
    text-align: center;
    max-width: 620px;
    margin: 0 auto;
    position: relative;
  }

  .hidden { display: none !important; }

  /* ── Loading ── */
  .loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    color: var(--text-secondary);
    padding: 48px 0;
  }

  .spinner {
    width: 36px;
    height: 36px;
    border: 3px solid var(--glass-border);
    border-top-color: var(--accent-color);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Day Number ── */
  .answer-day {
    font-size: 0.88rem;
    color: var(--accent-light);
    font-weight: 700;
    margin-bottom: 28px;
    padding: 6px 16px;
    background: var(--accent-gradient-subtle);
    border-radius: var(--radius-full);
    display: inline-block;
    border: 1px solid rgba(139, 92, 246, 0.15);
  }

  /* ── Spoiler ── */
  .spoiler-overlay {
    position: absolute;
    inset: 12px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: rgba(11, 13, 23, 0.5);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    cursor: pointer;
    font-family: inherit;
    transition:
      background var(--duration-normal) ease,
      border-color var(--duration-normal) ease,
      transform var(--duration-normal) var(--ease-out-expo);
  }

  .spoiler-overlay:hover {
    background: rgba(11, 13, 23, 0.6);
    border-color: var(--accent-color);
    transform: scale(1.01);
  }

  .spoiler-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-gradient-subtle);
    border: 1px solid rgba(139, 92, 246, 0.2);
    color: var(--accent-light);
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }

  .spoiler-overlay:hover .spoiler-icon { transform: scale(1.1); }

  .spoiler-text {
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .answer-content.blurred {
    filter: blur(24px) saturate(0.2);
    user-select: none;
    pointer-events: none;
  }

  /* ── Mode Toggle ── */
  .mode-toggle {
    display: inline-flex;
    gap: 4px;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 14px;
    padding: 4px;
    margin-bottom: 32px;
    border: 1px solid var(--glass-border);
  }

  .mode-btn {
    padding: 10px 28px;
    border-radius: 11px;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .mode-btn.active {
    background: var(--accent-gradient);
    color: white;
    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
  }

  .mode-btn:not(.active):hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
  }

  /* ── Blocks Section ── */
  .blocks-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .blocks-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }

  .blocks-row {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    align-items: flex-start;
  }

  .block-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    animation: blockIn 0.5s var(--ease-out-expo) both;
  }

  .color-block {
    width: 88px;
    height: 88px;
    border-radius: 20px;
    position: relative;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 12px 28px -8px rgba(0, 0, 0, 0.4),
      0 0 40px var(--block-glow, transparent);
    transition:
      transform 0.3s var(--ease-out-expo),
      box-shadow 0.3s ease;
    cursor: pointer;
  }

  .color-block:hover {
    transform: scale(1.08) translateY(-3px);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12) inset,
      0 20px 40px -12px rgba(0, 0, 0, 0.5),
      0 0 60px var(--block-glow, transparent);
  }

  .block-reflection {
    position: absolute;
    inset: 0;
    background: linear-gradient(170deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0.04) 35%, transparent 50%);
    pointer-events: none;
  }

  .block-label {
    font-family: 'JetBrains Mono', 'SF Mono', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: capitalize;
  }

  .block-weight {
    font-size: 0.68rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  @keyframes blockIn {
    from { transform: scale(0.8) translateY(10px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }

  /* ── Blend Section ── */
  .blend-section {
    margin-bottom: 28px;
    padding-top: 16px;
    border-top: 1px solid var(--border-color);
  }

  .blend-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .blend-swatch {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 8px 20px -6px rgba(0, 0, 0, 0.4),
      0 0 40px var(--blend-glow, transparent);
  }

  .blend-swatch .block-reflection {
    position: absolute;
    inset: 0;
    background: linear-gradient(170deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0.04) 35%, transparent 50%);
  }

  .blend-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blend-formula {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  /* ── Actions ── */
  .answer-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Error ── */
  .error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--text-secondary);
    padding: 32px 0;
  }

  .error-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(239, 68, 68, 0.1);
    color: var(--error);
  }

  /* ── Recent ── */
  .recent-section {
    max-width: 620px;
    margin: 48px auto 0;
  }

  .recent-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
  }

  .recent-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .recent-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    transition: all 0.2s ease;
  }

  .recent-item:hover {
    background: var(--bg-card-hover);
    border-color: var(--glass-border-hover);
  }

  .recent-dots {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }

  .recent-dot {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    position: relative;
    overflow: hidden;
  }

  .recent-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 7px;
    background: linear-gradient(170deg, rgba(255,255,255,0.18) 0%, transparent 45%);
  }

  .recent-date {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .page-title { font-size: 2.2rem; }
    .answer-card { padding: 32px 20px; }
    .color-block { width: 68px; height: 68px; border-radius: 16px; }
    .blend-swatch { width: 60px; height: 60px; }
  }

  @media (max-width: 640px) {
    .page-title { font-size: 1.8rem; }
    .color-block { width: 60px; height: 60px; }
  }
</style>

<script define:vars={{ apiUrl, today }}>
  const COLOR_NAMES = {
    '#FFFFFF': 'White', '#FFFAC8': 'Lemon', '#FABEBE': 'Pink',
    '#AAFFC3': 'Mint', '#E6BEFF': 'Lavender', '#46F0F0': 'Cyan',
    '#FFE119': 'Yellow', '#BCF60C': 'Lime', '#F58231': 'Orange',
    '#3CB44B': 'Green', '#F032E6': 'Magenta', '#808000': 'Olive',
    '#008080': 'Teal', '#9A6324': 'Brown', '#E6194B': 'Red',
    '#4363D8': 'Blue', '#911EB4': 'Purple', '#800000': 'Maroon',
    '#000075': 'Navy', '#000000': 'Black',
  };

  const NORMAL_WEIGHTS = [50, 34, 16];
  const HARD_WEIGHTS = [40, 30, 20, 10];

  let currentMode = 'normal';

  const dateDisplay = document.getElementById('dateDisplay');
  const loadingState = document.getElementById('loadingState');
  const answerState = document.getElementById('answerState');
  const errorState = document.getElementById('errorState');
  const dayNumber = document.getElementById('dayNumber');
  const normalSection = document.getElementById('normalSection');
  const hardSection = document.getElementById('hardSection');
  const blendSection = document.getElementById('blendSection');
  const recentList = document.getElementById('recentList');
  const spoilerOverlay = document.getElementById('spoilerOverlay');
  const answerContent = document.getElementById('answerContent');
  const normalBtn = document.getElementById('normalBtn');
  const hardBtn = document.getElementById('hardBtn');

  const now = new Date();
  dateDisplay.textContent = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

  // Spoiler reveal
  spoilerOverlay?.addEventListener('click', () => {
    spoilerOverlay.style.display = 'none';
    answerContent.classList.remove('blurred');
    answerContent.style.filter = 'none';
  });

  // Mode toggle
  normalBtn?.addEventListener('click', () => switchMode('normal'));
  hardBtn?.addEventListener('click', () => switchMode('hard'));

  function switchMode(mode) {
    currentMode = mode;
    if (mode === 'normal') {
      normalBtn.classList.add('active');
      hardBtn.classList.remove('active');
      normalSection.classList.remove('hidden');
      hardSection.classList.add('hidden');
    } else {
      hardBtn.classList.add('active');
      normalBtn.classList.remove('active');
      hardSection.classList.remove('hidden');
      normalSection.classList.add('hidden');
    }
    updateBlend();
  }

  function blendColors(colors, weights) {
    if (!colors.length) return '#888';
    const w = weights || colors.map(() => 1 / colors.length);
    const totalWeight = w.reduce((a, b) => a + b, 0);
    let r = 0, g = 0, b = 0;
    colors.forEach((c, i) => {
      const hex = c.replace('#', '');
      const cr = parseInt(hex.substring(0, 2), 16);
      const cg = parseInt(hex.substring(2, 4), 16);
      const cb = parseInt(hex.substring(4, 6), 16);
      const wt = w[i] / totalWeight;
      r += cr * wt;
      g += cg * wt;
      b += cb * wt;
    });
    return `rgb(${Math.round(r)}, ${Math.round(g)}, ${Math.round(b)})`;
  }

  let normalColors = [];
  let hardColors = [];

  function updateBlend() {
    const colors = currentMode === 'normal' ? normalColors : hardColors;
    const weights = currentMode === 'normal' ? NORMAL_WEIGHTS : HARD_WEIGHTS;
    if (!colors.length) { blendSection.innerHTML = ''; return; }

    const blended = blendColors(colors, weights);
    const formula = currentMode === 'normal'
      ? '50% + 34% + 16%'
      : '40% + 30% + 20% + 10%';

    blendSection.innerHTML = `
      <div class="blend-preview">
        <div class="blend-swatch" style="background: ${blended}; --blend-glow: ${blended}40;">
          <div class="block-reflection"></div>
        </div>
        <span class="blend-label">Mixed Result</span>
        <span class="blend-formula">${formula}</span>
      </div>
    `;
  }

  function renderBlocks(colors, weights) {
    return `
      <div class="blocks-row">
        ${colors.map((c, i) => `
          <div class="block-item" style="animation-delay: ${i * 0.12}s;">
            <div class="color-block" style="background: ${c}; --block-glow: ${c}30;">
              <div class="block-reflection"></div>
            </div>
            <span class="block-label">${COLOR_NAMES[c] || c}</span>
            ${weights[i] ? `<span class="block-weight">${weights[i]}%</span>` : ''}
          </div>
        `).join('')}
      </div>
    `;
  }

  async function loadAnswer() {
    try {
      const res = await fetch(`${apiUrl}/api/colorfle/today`);
      if (!res.ok) throw new Error('Failed');
      const data = await res.json();

      loadingState.classList.add('hidden');
      answerState.classList.remove('hidden');

      dayNumber.textContent = `Day #${data.day_number}`;
      normalColors = JSON.parse(data.normal_answer || '[]');
      hardColors = JSON.parse(data.hard_answer || '[]');

      normalSection.innerHTML = renderBlocks(normalColors, NORMAL_WEIGHTS);
      hardSection.innerHTML = renderBlocks(hardColors, HARD_WEIGHTS);
      updateBlend();
    } catch (e) {
      loadingState.classList.add('hidden');
      errorState.classList.remove('hidden');
    }
  }

  async function loadRecent() {
    try {
      const from = new Date(Date.now() - 7 * 86400000).toISOString().split('T')[0];
      const res = await fetch(`${apiUrl}/api/colorfle/range?from=${from}&to=${today}`);
      if (!res.ok) return;
      const data = await res.json();

      recentList.innerHTML = data.slice(0, 7).map(item => {
        const colors = JSON.parse(item.normal_answer || '[]');
        return `
          <div class="recent-item">
            <div class="recent-dots">
              ${colors.map(c => `<div class="recent-dot" style="background: ${c}"></div>`).join('')}
            </div>
            <div class="recent-date">${item.date} · Day #${item.day_number}</div>
          </div>
        `;
      }).join('');
    } catch (e) {
      console.error(e);
    }
  }

  loadAnswer();
  loadRecent();
</script>
