                      </div>
                    ))}
                  </div>
                  <div class="blend-visual">
                    <div class="blend-formula">
                      {normalColors.map((color, i) => (
                        <>
                          <div class="formula-part">
                            <div class="formula-dot" style={`background: ${color};`}></div>
