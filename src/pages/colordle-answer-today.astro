---
import Layout from '../layouts/Layout.astro';

const today = new Date().toISOString().split('T')[0];
const apiUrl = import.meta.env.PUBLIC_API_URL || '';
---

<Layout title="Colordle Answer Today">
  <section class="answer-page">
    <div class="container">
      <div class="page-header">
        <a href="/" class="back-link">← Back Home</a>
        <span class="badge">Colordle</span>
      </div>
      
      <h1 class="page-title">
        Colordle Answer<br/><span class="gradient-text">Today</span>
      </h1>
      <p class="page-subtitle" id="dateDisplay"></p>

      <div class="answer-card glass-card" id="answerCard">
        <div class="loading-state" id="loadingState">
          <div class="spinner"></div>
          <p>Loading today's answer...</p>
        </div>
        <div class="answer-state hidden" id="answerState">
          <div class="answer-day" id="dayNumber"></div>
          <div class="swatch-wrapper">
            <div class="color-swatch" id="colorSwatch"></div>
          </div>
          <div class="answer-details">
            <h2 class="color-name" id="colorName"></h2>
            <p class="color-hex" id="colorHex"></p>
          </div>
          <div class="answer-actions">
            <a href="https://colordle.ryantanen.com/" target="_blank" rel="noopener" class="btn-secondary">
              Play Colordle ↗
            </a>
            <a href="/colordle-archive" class="btn-secondary">
              View Archive
            </a>
          </div>
        </div>
        <div class="error-state hidden" id="errorState">
          <p>Could not load today's answer. Please try again later.</p>
        </div>
      </div>

      <!-- Recent Answers -->
      <div class="recent-section">
        <h3>Recent Answers</h3>
        <div class="recent-list" id="recentList"></div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .answer-page {
    padding: 40px 0 80px;
  }

  .page-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .back-link {
    color: var(--text-secondary);
    font-size: 0.88rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--accent-light);
  }

  .page-title {
    font-size: 2.8rem;
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 8px;
  }

  .page-subtitle {
    color: var(--text-secondary);
    font-size: 1rem;
    margin-bottom: 40px;
  }

  .answer-card {
    padding: 48px;
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .hidden { display: none !important; }

  .loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    color: var(--text-secondary);
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid var(--border-color);
    border-top-color: var(--accent-color);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .answer-day {
    font-size: 0.9rem;
    color: var(--accent-light);
    font-weight: 600;
    margin-bottom: 24px;
  }

  .swatch-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 24px;
  }

  .color-swatch {
    width: 180px;
    height: 180px;
    border-radius: 24px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    animation: swatchIn 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .color-swatch::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(180deg, rgba(255,255,255,0.15), transparent);
    border-radius: 24px 24px 0 0;
  }

  @keyframes swatchIn {
    from { transform: scale(0.8); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .answer-details {
    margin-bottom: 28px;
  }

  .color-name {
    font-size: 2rem;
    font-weight: 800;
    text-transform: capitalize;
    margin-bottom: 4px;
  }

  .color-hex {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .answer-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .error-state {
    color: var(--text-secondary);
  }

  .recent-section {
    max-width: 600px;
    margin: 48px auto 0;
  }

  .recent-section h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--text-secondary);
  }

  .recent-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .recent-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
  }

  .recent-item:hover {
    background: var(--bg-card-hover);
  }

  .recent-dot {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .recent-info {
    flex: 1;
  }

  .recent-name {
    font-weight: 600;
    font-size: 0.92rem;
    text-transform: capitalize;
  }

  .recent-date {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .page-title { font-size: 2rem; }
    .answer-card { padding: 32px 20px; }
    .color-swatch { width: 140px; height: 140px; }
    .color-name { font-size: 1.5rem; }
  }
</style>

<script define:vars={{ apiUrl, today }}>
  const dateDisplay = document.getElementById('dateDisplay');
  const loadingState = document.getElementById('loadingState');
  const answerState = document.getElementById('answerState');
  const errorState = document.getElementById('errorState');
  const dayNumber = document.getElementById('dayNumber');
  const colorSwatch = document.getElementById('colorSwatch');
  const colorName = document.getElementById('colorName');
  const colorHex = document.getElementById('colorHex');
  const recentList = document.getElementById('recentList');

  const now = new Date();
  dateDisplay.textContent = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

  async function loadAnswer() {
    try {
      const res = await fetch(`${apiUrl}/api/colordle/today`);
      if (!res.ok) throw new Error('Failed to fetch');
      const data = await res.json();

      loadingState.classList.add('hidden');
      answerState.classList.remove('hidden');
      
      dayNumber.textContent = `Day #${data.day_number}`;
      colorSwatch.style.background = data.color_hex || '#888';
      colorName.textContent = data.color_name;
      colorHex.textContent = data.color_hex || '';
    } catch (e) {
      loadingState.classList.add('hidden');
      errorState.classList.remove('hidden');
    }
  }

  async function loadRecent() {
    try {
      const to = today;
      const from = new Date(Date.now() - 7 * 86400000).toISOString().split('T')[0];
      const res = await fetch(`${apiUrl}/api/colordle/range?from=${from}&to=${to}`);
      if (!res.ok) return;
      const data = await res.json();
      
      recentList.innerHTML = data.slice(0, 7).map(item => `
        <div class="recent-item">
          <div class="recent-dot" style="background: ${item.color_hex || '#888'}"></div>
          <div class="recent-info">
            <div class="recent-name">${item.color_name || 'Unknown'}</div>
            <div class="recent-date">${item.date} · Day #${item.day_number}</div>
          </div>
        </div>
      `).join('');
    } catch (e) {}
  }

  loadAnswer();
  loadRecent();
</script>
