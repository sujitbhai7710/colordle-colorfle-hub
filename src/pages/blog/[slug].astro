---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const breadcrumbs = [
  { name: 'Blog', url: '/blog' },
  { name: post.data.title, url: `/blog/${post.id}` },
];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  canonicalUrl={`/blog/${post.id}`}
  keywords={post.data.tags.join(', ')}
  breadcrumbs={breadcrumbs}
>
  <style is:global>
    /* ═══ HERO ═══ */
    .blog-post-hero {
      padding: 64px 0 40px;
      background: var(--bg-hero);
      border-bottom: 1px solid var(--border-color);
    }

    .blog-post-hero-inner {
      max-width: 800px;
    }

    .blog-post-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--text-muted);
      text-decoration: none;
      margin-bottom: 20px;
      transition: color var(--duration-fast) ease;
    }

    .blog-post-back:hover { color: var(--accent-color); }

    .blog-post-back svg { transition: transform var(--duration-fast) ease; }
    .blog-post-back:hover svg { transform: translateX(-3px); }

    .blog-post-meta {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 16px;
      font-size: 0.88rem;
      color: var(--text-muted);
    }

    .blog-post-author { font-weight: 500; }

    .blog-post-tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .blog-post-tag {
      display: inline-flex;
      align-items: center;
      padding: 3px 12px;
      border-radius: var(--radius-full);
      font-size: 0.75rem;
      font-weight: 600;
      background: var(--accent-gradient-subtle);
      color: var(--accent-color);
      border: 1px solid rgba(37, 99, 235, 0.1);
    }

    .blog-post-hero h1 {
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-size: 2.4rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: var(--text-primary);
      line-height: 1.2;
    }

    @media (max-width: 768px) {
      .blog-post-hero { padding: 40px 0 24px; }
      .blog-post-hero h1 { font-size: 1.7rem; }
    }

    /* ═══ CONTENT LAYOUT: Sidebar + Main ═══ */
    .blog-post-body {
      padding: 48px 0 80px;
    }

    .blog-layout {
      display: flex;
      gap: 48px;
      align-items: flex-start;
    }

    /* ── Sticky TOC Sidebar ── */
    .blog-sidebar {
      position: sticky;
      top: 88px;
      width: 260px;
      flex-shrink: 0;
      background: #f0f4ff;
      border: 1px solid #d4ddef;
      border-radius: var(--radius-lg);
      padding: 24px;
    }

    .blog-sidebar-title {
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--brand-700);
      margin-bottom: 16px;
    }

    .blog-sidebar ol {
      list-style: decimal;
      padding-left: 18px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .blog-sidebar li {
      font-size: 0.86rem;
      line-height: 1.5;
    }

    .blog-sidebar a {
      color: var(--brand-700);
      font-weight: 500;
      text-decoration: none;
      transition: color var(--duration-fast) ease, text-decoration var(--duration-fast) ease;
    }

    .blog-sidebar a:hover {
      color: var(--brand-900);
      text-decoration: underline;
    }

    /* Hide sidebar on tablet and below */
    @media (max-width: 1024px) {
      .blog-sidebar { display: none; }
    }

    /* ── Main Content ── */
    .blog-main {
      flex: 1;
      min-width: 0;
      max-width: 800px;
    }

    /* ── Article Card Wrapper ── */
    .blog-article {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-sm);
      padding: 48px;
    }

    @media (max-width: 768px) {
      .blog-article { padding: 24px; }
    }

    /* ═══ RICH CONTENT STYLES ═══ */
    .blog-article h2 {
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-size: 1.65rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-top: 3rem;
      margin-bottom: 1.2rem;
      letter-spacing: -0.02em;
      line-height: 1.3;
      scroll-margin-top: 80px;
    }

    .blog-article h2:first-child {
      margin-top: 0;
    }

    .blog-article h3 {
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-top: 2.2rem;
      margin-bottom: 0.9rem;
      letter-spacing: -0.015em;
      line-height: 1.35;
    }

    .blog-article p {
      font-size: 1.08rem;
      line-height: 1.9;
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
    }

    .blog-article strong {
      color: var(--text-primary);
      font-weight: 600;
    }

    .blog-article ul,
    .blog-article ol {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
    }

    .blog-article li {
      font-size: 1.08rem;
      line-height: 1.9;
      color: var(--text-secondary);
      margin-bottom: 0.6rem;
    }

    .blog-article blockquote {
      border-left: 4px solid var(--accent-color);
      padding: 16px 24px;
      margin: 2rem 0;
      background: var(--brand-50);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      font-style: italic;
      color: var(--text-secondary);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .blog-article a {
      color: var(--accent-color);
      text-decoration: underline;
      text-underline-offset: 3px;
      font-weight: 500;
    }

    .blog-article a:hover { color: var(--accent-dark); }

    .blog-article hr {
      border: none;
      border-top: 1px solid var(--border-color);
      margin: 3rem 0;
    }

    .blog-article code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.88em;
      background: var(--bg-tertiary);
      padding: 2px 7px;
      border-radius: 4px;
    }

    .blog-article pre {
      background: var(--bg-dark);
      color: #e5e7eb;
      padding: 24px;
      border-radius: var(--radius-md);
      overflow-x: auto;
      margin: 2rem 0;
    }

    .blog-article pre code {
      background: none;
      padding: 0;
      font-size: 0.88rem;
    }

    /* ── Info Cards (used in markdown as HTML) ── */
    .blog-article .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin: 1.5rem 0;
    }

    @media (max-width: 640px) {
      .blog-article .info-grid {
        grid-template-columns: 1fr;
      }
    }

    .blog-article .info-card {
      background: #f8fafc;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 20px;
      box-shadow: var(--shadow-xs);
    }

    .blog-article .info-card h4 {
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      color: var(--text-primary);
      margin-bottom: 6px;
    }

    .blog-article .info-card p {
      font-size: 0.92rem;
      line-height: 1.65;
      margin-bottom: 0;
      color: var(--text-secondary);
    }

    /* ── Callout Box ── */
    .blog-article .callout {
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-radius: var(--radius-md);
      padding: 20px 24px;
      margin: 2rem 0;
    }

    .blog-article .callout-title {
      font-weight: 700;
      font-size: 0.95rem;
      color: #92400e;
      margin-bottom: 6px;
    }

    .blog-article .callout p {
      font-size: 0.95rem;
      color: #78350f;
      margin-bottom: 0;
    }

    /* ── Stat Highlight ── */
    .blog-article .stat-row {
      display: flex;
      gap: 20px;
      margin: 2rem 0;
      flex-wrap: wrap;
    }

    .blog-article .stat-item {
      flex: 1;
      min-width: 140px;
      background: var(--accent-gradient-subtle);
      border: 1px solid rgba(37, 99, 235, 0.1);
      border-radius: var(--radius-md);
      padding: 20px;
      text-align: center;
    }

    .blog-article .stat-number {
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-size: 2rem;
      font-weight: 800;
      color: var(--brand-700);
      display: block;
      line-height: 1.2;
    }

    .blog-article .stat-label {
      font-size: 0.85rem;
      color: var(--text-secondary);
      margin-top: 4px;
    }

    /* ── Key Takeaway Box ── */
    .blog-article .key-takeaway {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: var(--radius-md);
      padding: 20px 24px;
      margin: 2rem 0;
    }

    .blog-article .key-takeaway-title {
      font-weight: 700;
      font-size: 0.95rem;
      color: #166534;
      margin-bottom: 8px;
    }

    .blog-article .key-takeaway ul {
      margin-bottom: 0;
    }

    .blog-article .key-takeaway li {
      color: #15803d;
      font-size: 0.95rem;
    }

    /* ── Navigation Footer ── */
    .blog-post-nav {
      padding-top: 32px;
      border-top: 1px solid var(--border-color);
      margin-top: 48px;
    }

    .blog-post-nav a {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--accent-color);
      text-decoration: none;
    }

    .blog-post-nav a:hover {
      text-decoration: underline;
    }

    /* ── Mobile TOC (shown only on small screens) ── */
    .mobile-toc {
      display: none;
      background: #f0f4ff;
      border: 1px solid #d4ddef;
      border-radius: var(--radius-md);
      padding: 16px 20px;
      margin-bottom: 24px;
    }

    .mobile-toc-title {
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-size: 0.82rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--brand-700);
      margin-bottom: 10px;
    }

    .mobile-toc ol {
      list-style: decimal;
      padding-left: 16px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .mobile-toc li {
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .mobile-toc a {
      color: var(--brand-700);
      font-weight: 500;
      text-decoration: none;
    }

    .mobile-toc a:hover { text-decoration: underline; }

    @media (max-width: 1024px) {
      .mobile-toc { display: block; }
    }

    /* ── Full layout responsive ── */
    @media (max-width: 1024px) {
      .blog-layout {
        flex-direction: column;
      }
      .blog-main {
        max-width: 100%;
      }
    }
  </style>

  <!-- ═══ HERO ═══ -->
  <section class="blog-post-hero">
    <div class="container">
      <div class="blog-post-hero-inner">
        <a href="/blog" class="blog-post-back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Back to Blog
        </a>
        <div class="blog-post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
          <span aria-hidden="true">&middot;</span>
          <span class="blog-post-author">{post.data.author}</span>
        </div>
        <div class="blog-post-tags">
          {post.data.tags.map((tag: string) => (
            <span class="blog-post-tag">{tag}</span>
          ))}
        </div>
        <h1>{post.data.title}</h1>
      </div>
    </div>
  </section>

  <!-- ═══ CONTENT ═══ -->
  <section class="blog-post-body">
    <div class="container">
      <div class="blog-layout">
        <!-- Sticky TOC Sidebar (desktop) -->
        <nav class="blog-sidebar" aria-label="Table of Contents" id="toc-sidebar">
          <p class="blog-sidebar-title">Table of Contents</p>
          <ol id="toc-list">
            <!-- Populated by JS below -->
          </ol>
        </nav>

        <!-- Main Article -->
        <div class="blog-main">
          <!-- Mobile TOC -->
          <div class="mobile-toc" id="mobile-toc">
            <p class="mobile-toc-title">Table of Contents</p>
            <ol id="mobile-toc-list">
              <!-- Populated by JS below -->
            </ol>
          </div>

          <article class="blog-article">
            <Content />
          </article>

          <div class="blog-post-nav">
            <a href="/blog">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              Back to all articles
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Auto-generate TOC from h2 headings -->
  <script>
    function buildTOC() {
      const article = document.querySelector('.blog-article');
      const tocList = document.getElementById('toc-list');
      const mobileTocList = document.getElementById('mobile-toc-list');
      if (!article || !tocList || !mobileTocList) return;

      const headings = article.querySelectorAll('h2');
      if (headings.length === 0) {
        const sidebar = document.getElementById('toc-sidebar');
        const mobileToc = document.getElementById('mobile-toc');
        if (sidebar) sidebar.style.display = 'none';
        if (mobileToc) mobileToc.style.display = 'none';
        return;
      }

      headings.forEach((heading, index) => {
        const id = heading.id || `section-${index + 1}`;
        heading.id = id;
        heading.style.scrollMarginTop = '80px';

        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${id}`;
        a.textContent = heading.textContent;
        li.appendChild(a);

        // Desktop TOC
        tocList.appendChild(li.cloneNode(true));
        // Mobile TOC
        mobileTocList.appendChild(li);
      });
    }

    document.addEventListener('DOMContentLoaded', buildTOC);
    // Also run on Astro page transitions
    document.addEventListener('astro:page-load', buildTOC);
  </script>

  <!-- Article Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.pubDate.toISOString(),
    "dateModified": (post.data.updatedDate || post.data.pubDate).toISOString(),
    "author": {
      "@type": "Organization",
      "name": post.data.author
    },
    "publisher": {
      "@type": "Organization",
      "name": "Color Answers Hub",
      "url": "https://color-answers.pages.dev"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://color-answers.pages.dev/blog/${post.id}`
    }
  })} />
</Layout>
