                      <div class="blend-swatch" style={`background: ${normalBlended};`}>
                        <div class="block-reflection"></div>
                        <span class="blend-swatch-label" style={`color: ${normalBlendedIsLight ? 'var(--text-primary)' : '#FFFFFF'}; text-shadow: ${normalBlendedIsLight ? 'none' : '0 2px 6px rgba(0,0,0,0.2)'};`}>Mixed</span>
                      </div>
                      <span class="blend-label">Mixed Result</span>
                    </div>
                  </div>
                </div>

                <!-- Hard Mode -->
                <div class="mode-section hidden" id="hardSection">
                  <div class="section-label">Hard Mode — 4 Colors</div>
                  <div class="blocks-visual">
                    {hardColors.map((color, i) => (
                      <div class="color-block-item" style={`animation-delay: ${i * 0.1}s;`}>
                        <div class="color-block-swatch" style={`background: ${color};`}>
                          <div class="block-reflection"></div>
                          <span class="block-swatch-name" style={`color: ${isLightColor(color) ? 'var(--text-primary)' : '#FFFFFF'}; text-shadow: ${isLightColor(color) ? 'none' : '0 2px 6px rgba(0,0,0,0.2)'};`}>{hardNames[i] || color}</span>
                        </div>
                        <span class="color-block-weight">{HARD_WEIGHTS[i]}%</span>
                      </div>
                    ))}
                  </div>
                  <div class="blend-visual">
                    <div class="blend-formula">
                      {hardColors.map((color, i) => (
                        <>
                          <div class="formula-part">
                            <div class="formula-dot" style={`background: ${color};`}></div>
                            <span class="formula-name">{hardNames[i] || color}</span>
                            <span class="formula-pct">{HARD_WEIGHTS[i]}%</span>
                          </div>
                          {i < hardColors.length - 1 && <span class="formula-plus">+</span>}
                        </>
                      ))}
                      <span class="formula-equals">=</span>
                    </div>
                    <div class="blend-result">
                      <div class="blend-swatch" style={`background: ${hardBlended};`}>
                        <div class="block-reflection"></div>
                        <span class="blend-swatch-label" style={`color: ${hardBlendedIsLight ? 'var(--text-primary)' : '#FFFFFF'}; text-shadow: ${hardBlendedIsLight ? 'none' : '0 2px 6px rgba(0,0,0,0.2)'};`}>Mixed</span>
                      </div>
                      <span class="blend-label">Mixed Result</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Actions -->
              <div class="answer-actions">
                <a href="https://colorfle.com/" target="_blank" rel="noopener" class="btn-primary btn-colorfle">
                  Play Colorfle
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
                </a>
