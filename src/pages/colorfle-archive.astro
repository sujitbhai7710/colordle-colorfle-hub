---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Colorfle Answer Archive" canonicalUrl="/colorfle-archive" description="Browse the complete Colorfle archive with interactive calendar. Look up any past Colorfle answer since April 25, 2022 with color blocks and blend results.">
  <section class="archive-page">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb animate-fade-in-up" aria-label="Breadcrumb">
        <a href="/" class="breadcrumb-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          Home
        </a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">Colorfle Archive</span>
      </nav>

      <!-- Title -->
      <div class="page-header animate-fade-in-up delay-1">
        <h1 class="page-title">
          Colorfle <span class="colorfle-text">Archive</span>
        </h1>
        <p class="page-subtitle">Look up any past Colorfle answer — select a date on the calendar to reveal the colors</p>
      </div>

      <!-- Calendar Component -->
      <div class="animate-fade-in-up delay-2" id="calendarRoot"></div>
    </div>
  </section>
</Layout>

<style is:global>
  .archive-page {
    padding: 40px 0 96px;
  }

  /* ── Breadcrumb ── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    font-size: 0.85rem;
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text-muted);
    transition: color var(--duration-fast) ease;
  }

  .breadcrumb-link:hover { color: var(--accent-light); }
  .breadcrumb-sep { color: var(--text-muted); opacity: 0.5; }
  .breadcrumb-current { color: var(--text-secondary); font-weight: 500; }

  /* ── Page Header ── */
  .page-header { margin-bottom: 40px; }

  .page-title {
    font-family: 'Outfit', 'DM Sans', sans-serif;
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }

  .page-subtitle {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .page-title { font-size: 2.2rem; }
  }

  @media (max-width: 640px) {
    .page-title { font-size: 1.8rem; }
  }
</style>

<script>
  import { mount } from 'svelte';
  import Calendar from '../components/Calendar.svelte';
  const root = document.getElementById('calendarRoot');
  if (root) {
    mount(Calendar, { target: root, props: { game: 'colorfle' } });
  }
</script>
