<script>
  // Spoiler reveal
  const spoilerOverlay = document.getElementById('spoilerOverlay');
  const answerContent = document.getElementById('answerContent');

  spoilerOverlay?.addEventListener('click', () => {
    spoilerOverlay.style.display = 'none';
    answerContent.classList.remove('blurred');
    answerContent.style.filter = 'none';
  });

  // Mode toggle
  const normalBtn = document.getElementById('normalBtn');
  const hardBtn = document.getElementById('hardBtn');
  const normalSection = document.getElementById('normalSection');
  const hardSection = document.getElementById('hardSection');

  normalBtn?.addEventListener('click', () => {
    normalBtn.classList.add('active');
    hardBtn.classList.remove('active');
    normalSection.classList.remove('hidden');
    hardSection.classList.add('hidden');
  });

  hardBtn?.addEventListener('click', () => {
    hardBtn.classList.add('active');
    normalBtn.classList.remove('active');
    hardSection.classList.remove('hidden');
    normalSection.classList.add('hidden');
  });

  // FAQ toggle
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      const answer = btn.nextElementSibling;
      answer.classList.toggle('open');
    });
  });
</script>
