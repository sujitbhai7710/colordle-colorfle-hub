---
import Layout from '../layouts/Layout.astro';

const today = new Date().toISOString().split('T')[0];
const apiUrl = import.meta.env.PUBLIC_API_URL || '';
---

<Layout title="Colorfle Answer Today">
  <section class="answer-page">
    <div class="container">
      <div class="page-header">
        <a href="/" class="back-link">← Back Home</a>
        <span class="badge">Colorfle</span>
      </div>
      
      <h1 class="page-title">
        Colorfle Answer<br/><span class="gradient-text">Today</span>
      </h1>
      <p class="page-subtitle" id="dateDisplay"></p>

      <div class="answer-card glass-card" id="answerCard">
        <div class="loading-state" id="loadingState">
          <div class="spinner"></div>
          <p>Loading today's answer...</p>
        </div>
        <div class="answer-state hidden" id="answerState">
          <div class="answer-day" id="dayNumber"></div>
          
          <div class="mode-toggle">
            <button class="mode-btn active" id="normalBtn" onclick="switchMode('normal')">Normal</button>
            <button class="mode-btn" id="hardBtn" onclick="switchMode('hard')">Hard</button>
          </div>

          <div class="answer-blocks" id="normalBlocks"></div>
          <div class="answer-blocks hidden" id="hardBlocks"></div>

          <div class="answer-actions">
            <a href="https://colorfle.com/" target="_blank" rel="noopener" class="btn-secondary">
              Play Colorfle ↗
            </a>
            <a href="/colorfle-archive" class="btn-secondary">
              View Archive
            </a>
          </div>
        </div>
        <div class="error-state hidden" id="errorState">
          <p>Could not load today's answer. Please try again later.</p>
        </div>
      </div>

      <!-- Recent Answers -->
      <div class="recent-section">
        <h3>Recent Answers</h3>
        <div class="recent-list" id="recentList"></div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .answer-page { padding: 40px 0 80px; }
  .page-header { display: flex; align-items: center; gap: 16px; margin-bottom: 24px; }
  .back-link { color: var(--text-secondary); font-size: 0.88rem; transition: color 0.2s ease; }
  .back-link:hover { color: var(--accent-light); }
  .page-title { font-size: 2.8rem; font-weight: 900; line-height: 1.1; margin-bottom: 8px; }
  .page-subtitle { color: var(--text-secondary); font-size: 1rem; margin-bottom: 40px; }
  .answer-card { padding: 48px; text-align: center; max-width: 600px; margin: 0 auto; }
  .hidden { display: none !important; }
  .loading-state { display: flex; flex-direction: column; align-items: center; gap: 16px; color: var(--text-secondary); }
  .spinner { width: 40px; height: 40px; border: 3px solid var(--border-color); border-top-color: var(--accent-color); border-radius: 50%; animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .answer-day { font-size: 0.9rem; color: var(--accent-light); font-weight: 600; margin-bottom: 20px; }
  
  .mode-toggle {
    display: flex;
    gap: 4px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 4px;
    margin-bottom: 28px;
    justify-content: center;
  }

  .mode-btn {
    padding: 8px 24px;
    border-radius: 10px;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mode-btn.active {
    background: var(--accent-gradient);
    color: white;
  }

  .answer-blocks {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .answer-block-item {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    position: relative;
    overflow: hidden;
    animation: blockIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .answer-block-item::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 35%;
    background: linear-gradient(180deg, rgba(255,255,255,0.15), transparent);
    border-radius: 16px 16px 0 0;
  }

  .block-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-align: center;
    margin-top: 6px;
  }

  @keyframes blockIn {
    from { transform: scale(0.8) translateY(10px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }

  .answer-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .error-state { color: var(--text-secondary); }
  .recent-section { max-width: 600px; margin: 48px auto 0; }
  .recent-section h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 16px; color: var(--text-secondary); }
  .recent-list { display: flex; flex-direction: column; gap: 8px; }
  .recent-item { display: flex; align-items: center; gap: 8px; padding: 12px 16px; background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: var(--radius-md); }
  .recent-dots { display: flex; gap: 4px; }
  .recent-dot { width: 24px; height: 24px; border-radius: 6px; }
  .recent-date { font-size: 0.8rem; color: var(--text-muted); }

  @media (max-width: 768px) {
    .page-title { font-size: 2rem; }
    .answer-card { padding: 32px 20px; }
    .answer-block-item { width: 56px; height: 56px; }
  }
</style>

<script define:vars={{ apiUrl, today }}>
  let normalAnswer = [];
  let hardAnswer = [];

  const dateDisplay = document.getElementById('dateDisplay');
  const loadingState = document.getElementById('loadingState');
  const answerState = document.getElementById('answerState');
  const errorState = document.getElementById('errorState');
  const dayNumber = document.getElementById('dayNumber');
  const normalBlocks = document.getElementById('normalBlocks');
  const hardBlocks = document.getElementById('hardBlocks');
  const recentList = document.getElementById('recentList');

  const now = new Date();
  dateDisplay.textContent = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

  const COLOR_NAMES = {
    '#FFFFFF': 'White', '#FFFAC8': 'Lemon', '#FABEBE': 'Pink',
    '#AAFFC3': 'Mint', '#E6BEFF': 'Lavender', '#46F0F0': 'Cyan',
    '#FFE119': 'Yellow', '#BCF60C': 'Lime', '#F58231': 'Orange',
    '#3CB44B': 'Green', '#F032E6': 'Magenta', '#808000': 'Olive',
    '#008080': 'Teal', '#9A6324': 'Brown', '#E6194B': 'Red',
    '#4363D8': 'Blue', '#911EB4': 'Purple', '#800000': 'Maroon',
    '#000075': 'Navy', '#000000': 'Black',
  };

  function renderBlocks(container, colors) {
    container.innerHTML = colors.map((c, i) => `
      <div>
        <div class="answer-block-item" style="background: ${c}; animation-delay: ${i * 0.12}s"></div>
        <div class="block-label">${COLOR_NAMES[c] || c}</div>
      </div>
    `).join('');
  }

  window.switchMode = function(mode) {
    const normalBtn = document.getElementById('normalBtn');
    const hardBtn = document.getElementById('hardBtn');
    if (mode === 'normal') {
      normalBtn.classList.add('active');
      hardBtn.classList.remove('active');
      normalBlocks.classList.remove('hidden');
      hardBlocks.classList.add('hidden');
    } else {
      hardBtn.classList.add('active');
      normalBtn.classList.remove('active');
      hardBlocks.classList.remove('hidden');
      normalBlocks.classList.add('hidden');
    }
  };

  async function loadAnswer() {
    try {
      const res = await fetch(`${apiUrl}/api/colorfle/today`);
      if (!res.ok) throw new Error('Failed');
      const data = await res.json();

      loadingState.classList.add('hidden');
      answerState.classList.remove('hidden');
      
      dayNumber.textContent = `Day #${data.day_number}`;
      normalAnswer = JSON.parse(data.normal_answer || '[]');
      hardAnswer = JSON.parse(data.hard_answer || '[]');
      
      renderBlocks(normalBlocks, normalAnswer);
      renderBlocks(hardBlocks, hardAnswer);
    } catch (e) {
      loadingState.classList.add('hidden');
      errorState.classList.remove('hidden');
    }
  }

  async function loadRecent() {
    try {
      const from = new Date(Date.now() - 7 * 86400000).toISOString().split('T')[0];
      const res = await fetch(`${apiUrl}/api/colorfle/range?from=${from}&to=${today}`);
      if (!res.ok) return;
      const data = await res.json();
      
      recentList.innerHTML = data.slice(0, 7).map(item => {
        const colors = JSON.parse(item.normal_answer || '[]');
        return `
          <div class="recent-item">
            <div class="recent-dots">
              ${colors.map(c => `<div class="recent-dot" style="background: ${c}"></div>`).join('')}
            </div>
            <div class="recent-date">${item.date} · Day #${item.day_number}</div>
          </div>
        `;
      }).join('');
    } catch (e) {}
  }

  loadAnswer();
  loadRecent();
</script>
