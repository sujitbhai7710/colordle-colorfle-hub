---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us"
  canonicalUrl="/contact"
  description="Get in touch with Color Answers Hub. Report wrong answers, suggest features, or ask questions about Colordle and Colorfle daily puzzle answers."
  keywords="contact color answers hub, colordle help, colorfle help, report colordle issue, colorfle support"
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Contact Us", url: "/contact" }]}
>
  <style is:global>
    /* ═══ HERO ═══ */
    .blog-post-hero {
      padding: 64px 0 40px;
      background: var(--bg-hero);
      border-bottom: 1px solid var(--border-color);
    }

    .blog-post-hero-inner {
      max-width: 800px;
    }

    .blog-post-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--text-muted);
      text-decoration: none;
      margin-bottom: 20px;
      transition: color var(--duration-fast) ease;
    }

    .blog-post-back:hover { color: var(--accent-color); }

    .blog-post-back svg { transition: transform var(--duration-fast) ease; }
    .blog-post-back:hover svg { transform: translateX(-3px); }

    .blog-post-hero h1 {
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-size: 2.4rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: var(--text-primary);
      line-height: 1.2;
    }

    .hero-description {
      font-size: 1.08rem;
      line-height: 1.75;
      color: var(--text-secondary);
      margin-top: 12px;
      max-width: 600px;
    }

    @media (max-width: 768px) {
      .blog-post-hero { padding: 40px 0 24px; }
      .blog-post-hero h1 { font-size: 1.7rem; }
    }

    /* ═══ CONTENT LAYOUT: Sidebar + Main ═══ */
    .blog-post-body {
      padding: 48px 0 80px;
    }

    .blog-layout {
      display: flex;
      gap: 48px;
      align-items: flex-start;
    }

    /* ── Sticky TOC Sidebar ── */
    .blog-sidebar {
      position: sticky;
      top: 88px;
      width: 260px;
      flex-shrink: 0;
      background: #f0f4ff;
      border: 1px solid #d4ddef;
      border-radius: var(--radius-lg);
      padding: 24px;
    }

    .blog-sidebar-title {
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--brand-700);
      margin-bottom: 16px;
    }

    .blog-sidebar ol {
      list-style: decimal;
      padding-left: 18px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .blog-sidebar li {
      font-size: 0.86rem;
      line-height: 1.5;
    }

    .blog-sidebar a {
      color: var(--brand-700);
      font-weight: 500;
      text-decoration: none;
      transition: color var(--duration-fast) ease, text-decoration var(--duration-fast) ease;
    }

    .blog-sidebar a:hover {
      color: var(--brand-900);
      text-decoration: underline;
    }

    @media (max-width: 1024px) {
      .blog-sidebar { display: none; }
    }

    /* ── Main Content ── */
    .blog-main {
      flex: 1;
      min-width: 0;
      max-width: 800px;
    }

    /* ── Article Card Wrapper ── */
    .blog-article {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-sm);
      padding: 48px;
    }

    @media (max-width: 768px) {
      .blog-article { padding: 24px; }
    }

    /* ═══ RICH CONTENT STYLES ═══ */
    .blog-article h2 {
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-size: 1.65rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-top: 3rem;
      margin-bottom: 1.2rem;
      letter-spacing: -0.02em;
      line-height: 1.3;
      scroll-margin-top: 80px;
    }

    .blog-article h2:first-child {
      margin-top: 0;
    }

    .blog-article h3 {
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-top: 2.2rem;
      margin-bottom: 0.9rem;
      letter-spacing: -0.015em;
      line-height: 1.35;
    }

    .blog-article p {
      font-size: 1.08rem;
      line-height: 1.9;
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
    }

    .blog-article strong {
      color: var(--text-primary);
      font-weight: 600;
    }

    .blog-article a {
      color: var(--accent-color);
      text-decoration: underline;
      text-underline-offset: 3px;
      font-weight: 500;
    }

    .blog-article a:hover { color: var(--accent-dark); }

    .blog-article ul,
    .blog-article ol {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
    }

    .blog-article li {
      font-size: 1.08rem;
      line-height: 1.9;
      color: var(--text-secondary);
      margin-bottom: 0.6rem;
    }

    .blog-article blockquote {
      border-left: 4px solid var(--accent-color);
      padding: 16px 24px;
      margin: 2rem 0;
      background: var(--brand-50);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      font-style: italic;
      color: var(--text-secondary);
      font-size: 1.05rem;
      line-height: 1.8;
    }

    .blog-article hr {
      border: none;
      border-top: 1px solid var(--border-color);
      margin: 3rem 0;
    }

    /* ── Info Cards ── */
    .blog-article .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin: 1.5rem 0;
    }

    @media (max-width: 640px) {
      .blog-article .info-grid {
        grid-template-columns: 1fr;
      }
    }

    .blog-article .info-card {
      background: #f8fafc;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 20px;
      box-shadow: var(--shadow-xs);
    }

    .blog-article .info-card h4 {
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      color: var(--text-primary);
      margin-bottom: 6px;
    }

    .blog-article .info-card p {
      font-size: 0.92rem;
      line-height: 1.65;
      margin-bottom: 0;
      color: var(--text-secondary);
    }

    .blog-article .info-card .info-icon {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-md);
      background: var(--accent-gradient-subtle);
      border: 1px solid rgba(37, 99, 235, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent-color);
      margin-bottom: 12px;
    }

    /* ── Callout Box ── */
    .blog-article .callout {
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-radius: var(--radius-md);
      padding: 20px 24px;
      margin: 2rem 0;
    }

    .blog-article .callout-title {
      font-weight: 700;
      font-size: 0.95rem;
      color: #92400e;
      margin-bottom: 6px;
    }

    .blog-article .callout p {
      font-size: 0.95rem;
      color: #78350f;
      margin-bottom: 0;
    }

    /* ── Key Takeaway Box ── */
    .blog-article .key-takeaway {
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: var(--radius-md);
      padding: 20px 24px;
      margin: 2rem 0;
    }

    .blog-article .key-takeaway-title {
      font-weight: 700;
      font-size: 0.95rem;
      color: #166534;
      margin-bottom: 8px;
    }

    .blog-article .key-takeaway ul {
      margin-bottom: 0;
    }

    .blog-article .key-takeaway li {
      color: #15803d;
      font-size: 0.95rem;
    }

    /* ═══ CONTACT FORM STYLES ═══ */
    .contact-form {
      margin: 1.5rem 0 0;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    @media (max-width: 640px) {
      .form-row {
        grid-template-columns: 1fr;
        gap: 0;
      }
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 20px;
    }

    .form-group:last-child {
      margin-bottom: 0;
    }

    .form-label {
      font-family: 'DM Sans', sans-serif;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text-primary);
      display: block;
      margin-bottom: 6px;
      letter-spacing: -0.01em;
    }

    .form-input {
      width: 100%;
      padding: 12px 16px;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      background: var(--bg-primary);
      color: var(--text-primary);
      font-family: 'DM Sans', sans-serif;
      font-size: 0.95rem;
      transition:
        border-color var(--duration-fast) ease,
        box-shadow var(--duration-fast) ease,
        background var(--duration-fast) ease;
      outline: none;
    }

    .form-input::placeholder {
      color: var(--text-muted);
    }

    .form-input:hover {
      border-color: var(--border-hover);
    }

    .form-input:focus {
      border-color: var(--accent-color);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
      background: var(--bg-secondary);
    }

    .form-select {
      appearance: none;
      -webkit-appearance: none;
      background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%238B8FA3' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: right 16px center;
      padding-right: 40px;
      cursor: pointer;
    }

    .form-select:focus {
      background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1.5L6 6.5L11 1.5' stroke='%232563eb' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    }

    .form-textarea {
      resize: vertical;
      min-height: 140px;
      line-height: 1.6;
    }

    .form-submit {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 28px;
      background: var(--colordle-gradient);
      color: white;
      border: none;
      border-radius: var(--radius-full);
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition:
        transform var(--duration-normal) var(--ease-out-expo),
        box-shadow var(--duration-normal) ease;
      margin-top: 4px;
    }

    .form-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(37, 99, 235, 0.35);
      color: white;
    }

    .form-submit:active {
      transform: translateY(0);
    }

    /* ── Form Success State ── */
    .form-success {
      text-align: center;
      padding: 40px 0;
    }

    .form-success-icon {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: rgba(16, 185, 129, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
    }

    .form-success h3 {
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 8px;
      color: var(--text-primary);
    }

    .form-success p {
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.7;
      max-width: 400px;
      margin: 0 auto;
    }

    .form-success a {
      color: var(--accent-color);
      text-decoration: underline;
    }

    /* ═══ FAQ STYLES ═══ */
    .faq-item {
      padding: 0;
      overflow: hidden;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      margin-bottom: 10px;
      background: var(--bg-primary);
    }

    .faq-question {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 20px 24px;
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-primary);
      cursor: pointer;
      list-style: none;
      transition: color var(--duration-fast) ease;
      user-select: none;
    }

    .faq-question::-webkit-details-marker { display: none; }
    .faq-question::marker { display: none; content: ''; }

    .faq-question:hover { color: var(--accent-color); }

    .faq-item[open] .faq-question {
      border-bottom: 1px solid var(--border-color);
    }

    .faq-answer {
      padding: 20px 24px 24px;
      font-size: 0.95rem;
      line-height: 1.8;
      color: var(--text-secondary);
    }

    .faq-answer p:last-child { margin-bottom: 0; }

    /* ── Navigation Footer ── */
    .blog-post-nav {
      padding-top: 32px;
      border-top: 1px solid var(--border-color);
      margin-top: 48px;
    }

    .blog-post-nav a {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--accent-color);
      text-decoration: none;
    }

    .blog-post-nav a:hover { text-decoration: underline; }

    /* ── Mobile TOC ── */
    .mobile-toc {
      display: none;
      background: #f0f4ff;
      border: 1px solid #d4ddef;
      border-radius: var(--radius-md);
      padding: 16px 20px;
      margin-bottom: 24px;
    }

    .mobile-toc-title {
      font-family: 'Outfit', 'DM Sans', sans-serif;
      font-size: 0.82rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--brand-700);
      margin-bottom: 10px;
    }

    .mobile-toc ol {
      list-style: decimal;
      padding-left: 16px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .mobile-toc li {
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .mobile-toc a {
      color: var(--brand-700);
      font-weight: 500;
      text-decoration: none;
    }

    .mobile-toc a:hover { text-decoration: underline; }

    @media (max-width: 1024px) {
      .mobile-toc { display: block; }
    }

    /* ── Full layout responsive ── */
    @media (max-width: 1024px) {
      .blog-layout { flex-direction: column; }
      .blog-main { max-width: 100%; }
    }
  </style>

  <!-- ═══ HERO ═══ -->
  <section class="blog-post-hero">
    <div class="container">
      <div class="blog-post-hero-inner">
        <a href="/" class="blog-post-back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Back to Home
        </a>
        <h1>Contact Us</h1>
        <p class="hero-description">Got a question, found a wrong answer, or want to suggest something? We'd love to hear from you. A real person reads every message — no chatbots, no ticket numbers.</p>
      </div>
    </div>
  </section>

  <!-- ═══ CONTENT ═══ -->
  <section class="blog-post-body">
    <div class="container">
      <div class="blog-layout">
        <!-- Sticky TOC Sidebar (desktop) -->
        <nav class="blog-sidebar" aria-label="Table of Contents" id="toc-sidebar">
          <p class="blog-sidebar-title">On This Page</p>
          <ol id="toc-list">
            <!-- Populated by JS below -->
          </ol>
        </nav>

        <!-- Main Article -->
        <div class="blog-main">
          <!-- Mobile TOC -->
          <div class="mobile-toc" id="mobile-toc">
            <p class="mobile-toc-title">On This Page</p>
            <ol id="mobile-toc-list">
              <!-- Populated by JS below -->
            </ol>
          </div>

          <article class="blog-article">

            <!-- ═══ INFO CARDS ═══ -->
            <div class="info-grid">
              <div class="info-card">
                <div class="info-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <h4>Response Time</h4>
                <p>We typically respond within <strong>24–48 hours</strong>. Weekends may take a bit longer. If you haven't heard back after 3 days, please resend — no hard feelings.</p>
              </div>
              <div class="info-card">
                <div class="info-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                </div>
                <h4>Common Reasons to Contact</h4>
                <p>Report a wrong answer, suggest a feature, ask how something works, flag a bug, or just say hi. We genuinely appreciate all feedback.</p>
              </div>
              <div class="info-card">
                <div class="info-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </div>
                <h4>What to Include</h4>
                <p>For answer reports: the date, game name, and what you expected vs. what we showed. For bugs: your browser/device and steps to reproduce.</p>
              </div>
              <div class="info-card">
                <div class="info-icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <h4>Email Us Directly</h4>
                <p>Prefer email? Reach us at <a href="mailto:coloranswershub@gmail.com">coloranswershub@gmail.com</a>. We check it daily and respond to every message.</p>
              </div>
            </div>

            <!-- ═══ CONTACT FORM ═══ -->
            <h2 id="send-a-message">Send Us a Message</h2>
            <p>Fill out the form below and we'll get back to you. No chatbots, no ticket numbers to track — a real person reads every single message.</p>

            <form class="contact-form" id="contactForm" action="mailto:coloranswershub@gmail.com" method="post" enctype="text/plain">
              <div id="formFields">
                <div class="form-row">
                  <div class="form-group">
                    <label for="name" class="form-label">Name</label>
                    <input
                      type="text"
                      id="name"
                      name="Name"
                      class="form-input"
                      placeholder="Your name"
                      required
                    />
                  </div>
                  <div class="form-group">
                    <label for="email" class="form-label">Email</label>
                    <input
                      type="email"
                      id="email"
                      name="Email"
                      class="form-input"
                      placeholder="you@example.com"
                      required
                    />
                  </div>
                </div>

                <div class="form-group">
                  <label for="subject" class="form-label">Subject</label>
                  <select id="subject" name="Subject" class="form-input form-select" required>
                    <option value="" disabled selected>Choose a topic…</option>
                    <option value="General Inquiry">General Inquiry</option>
                    <option value="Report Wrong Answer">Report Wrong Answer</option>
                    <option value="Suggestion">Suggestion</option>
                    <option value="Bug Report">Bug Report</option>
                    <option value="Other">Other</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="message" class="form-label">Message</label>
                  <textarea
                    id="message"
                    name="Message"
                    class="form-input form-textarea"
                    placeholder="Tell us what's on your mind…"
                    rows="6"
                    required
                  ></textarea>
                </div>

                <button type="submit" class="form-submit">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                  Send Message
                </button>
              </div>
              <div id="formSuccess" style="display: none;">
                <div class="form-success">
                  <div class="form-success-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  </div>
                  <h3>Thank you!</h3>
                  <p>Your message has been received. We typically respond within 24–48 hours. You can also reach us directly at <a href="mailto:coloranswershub@gmail.com">coloranswershub@gmail.com</a>.</p>
                </div>
              </div>
            </form>

            <hr />

            <!-- ═══ FAQ SECTION ═══ -->
            <h2 id="frequently-asked-questions">Frequently Asked Questions</h2>
            <p>Before you write to us, there's a good chance your question is answered below. We compiled these from the messages we receive most often.</p>

            <details class="faq-item">
              <summary class="faq-question">
                <span>How quickly do you respond to messages?</span>
                <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <div class="faq-answer">
                <p>We typically respond within <strong>24 to 48 hours</strong> on business days. Weekends and holidays may take a little longer. We're a small team — really just a couple of people who built this site — so we can't always respond instantly, but we genuinely read and reply to every message. If you haven't heard back after 3 days, please resend. No hard feelings, sometimes things get lost.</p>
              </div>
            </details>

            <details class="faq-item">
              <summary class="faq-question">
                <span>I think an answer on your site is wrong. What should I do?</span>
