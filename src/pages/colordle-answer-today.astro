---
import Layout from '../layouts/Layout.astro';

const today = new Date().toISOString().split('T')[0];
const apiUrl = import.meta.env.PUBLIC_API_URL || '';
---

<Layout title="Colordle Answer Today" canonicalUrl="/colordle-answer-today" description="Today's Colordle answer revealed with the actual color swatch, hex code, and color name. Updated daily with spoiler protection.">
  <section class="answer-page">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb animate-fade-in-up" aria-label="Breadcrumb">
        <a href="/" class="breadcrumb-link">Home</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">Colordle Today</span>
      </nav>

      <!-- Title -->
      <div class="page-header animate-fade-in-up delay-1">
        <h1 class="page-title">
          Colordle Answer <span class="colordle-text">Today</span>
        </h1>
        <p class="page-date" id="dateDisplay"></p>
      </div>

      <!-- Main Answer Card -->
      <div class="answer-card card animate-fade-in-up delay-2" id="answerCard">
        <!-- Loading State -->
        <div class="loading-state" id="loadingState">
          <div class="spinner"></div>
          <p>Loading today's answer...</p>
        </div>

        <!-- Answer State -->
        <div class="answer-state hidden" id="answerState">
          <div class="answer-day" id="dayNumber"></div>

          <!-- Spoiler-protected swatch -->
          <div class="swatch-container" id="swatchContainer">
            <div class="spoiler-overlay" id="spoilerOverlay">
              <div class="spoiler-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              </div>
              <span class="spoiler-text">Click to Reveal Answer</span>
            </div>
            <div class="swatch-content blurred" id="swatchContent">
              <div class="color-swatch" id="colorSwatch">
                <div class="color-reflection"></div>
                <div class="swatch-label" id="swatchLabel"></div>
              </div>
            </div>
          </div>

          <div class="answer-info blurred" id="answerInfo">
            <h2 class="color-name" id="colorName"></h2>
            <p class="color-hex" id="colorHex"></p>
            <div class="copy-hint">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              Click hex to copy
            </div>
          </div>

          <div class="answer-actions">
            <a href="https://colordle.ryantanen.com/" target="_blank" rel="noopener" class="btn-primary btn-colordle">
              Play Colordle
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
            </a>
            <a href="/colordle-archive" class="btn-secondary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              View Archive
            </a>
          </div>
        </div>

        <!-- Error State -->
        <div class="error-state hidden" id="errorState">
          <div class="error-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          </div>
          <p>Could not load today's answer. Please try again later.</p>
        </div>
      </div>

      <!-- Recent Answers -->
      <div class="recent-section animate-fade-in-up delay-3">
        <h3 class="recent-title">Recent Answers</h3>
        <div class="recent-list" id="recentList">
          <div class="skeleton" style="height: 56px; margin-bottom: 8px;"></div>
          <div class="skeleton" style="height: 56px; margin-bottom: 8px;"></div>
          <div class="skeleton" style="height: 56px;"></div>
        </div>
      </div>

      <!-- SEO Content -->
      <div class="seo-content animate-fade-in-up delay-4">
        <h2>What Is Colordle?</h2>
        <p>Colordle is a daily color guessing game where players try to identify a mystery color by its name. Each day brings a new challenge — a single color name that you need to guess from the game's curated palette of 20 distinct colors. The game draws from a pool that includes everything from common colors like Red and Blue to more unusual entries like Magenta and Maroon, making each day's puzzle a fresh test of your color knowledge.</p>

        <p>The game works on a simple premise: you see the color name options and have to figure out which one is today's answer. It's a bite-sized puzzle that takes just a minute to play but keeps you coming back every day. The color palette includes White, Lemon, Pink, Mint, Lavender, Cyan, Yellow, Lime, Orange, Green, Magenta, Olive, Teal, Brown, Red, Blue, Purple, Maroon, Navy, and Black — twenty colors that span the full spectrum.</p>

        <h2>How We Get Today's Colordle Answer</h2>
        <p>Our answer system uses the exact same algorithm that powers the original Colordle game at colordle.ryantanen.com. We don't scrape or guess — we compute. The algorithm takes today's date, converts it to a day number (counting from the game's start date of March 26, 2022), and applies the same deterministic selection process that the game uses. This means our answer matches the official game every single time.</p>

        <p>We also run automated checks multiple times a day — at midnight, 8AM, and noon IST — to ensure our database is always current. If a new day's answer hasn't been computed yet, our API calculates it on the fly. Every answer we display has been verified against the game's own logic, so you can trust what you see here.</p>

        <h2>Using the Colordle Archive</h2>
        <p>Beyond today's answer, we maintain a complete archive of every Colordle answer dating back to the game's launch. Our interactive calendar lets you click on any date to instantly see what the answer was that day. Each archive entry shows the color name, the actual color swatch filled with the correct hue, and the hex code — the same visual format we use for today's answer.</p>

        <p>The archive is useful if you missed a day and want to check what the answer was, or if you're tracking patterns in the game's color selections over time. Since Colordle uses a deterministic algorithm, the answers follow a predictable sequence, but the day-to-day variation keeps things interesting enough that most players still find it worthwhile to check each day.</p>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .answer-page {
    padding: 32px 0 80px;
  }

  /* ── Breadcrumb ── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    font-size: 0.85rem;
  }

  .breadcrumb-link {
    color: var(--text-muted);
    transition: color var(--duration-fast) ease;
  }

  .breadcrumb-link:hover { color: var(--accent-color); }
  .breadcrumb-sep { color: var(--text-muted); opacity: 0.4; }
  .breadcrumb-current { color: var(--text-secondary); font-weight: 500; }

  /* ── Page Header ── */
  .page-header { margin-bottom: 36px; }

  .page-title {
    font-family: 'Outfit', 'DM Sans', sans-serif;
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }

  .page-date {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  /* ── Answer Card ── */
  .answer-card {
    padding: 48px 40px;
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
  }

  .hidden { display: none !important; }

  /* ── Loading ── */
  .loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    color: var(--text-secondary);
    padding: 40px 0;
  }

  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid var(--border-color);
    border-top-color: var(--accent-color);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Answer Day ── */
  .answer-day {
    font-family: 'Outfit', 'DM Sans', sans-serif;
    font-size: 0.85rem;
    color: var(--accent-color);
    font-weight: 700;
    margin-bottom: 28px;
    padding: 6px 18px;
    background: var(--accent-gradient-subtle);
    border-radius: var(--radius-full);
    display: inline-block;
    border: 1px solid rgba(91, 95, 230, 0.1);
    letter-spacing: 0.02em;
  }

  /* ── Spoiler ── */
  .swatch-container {
    position: relative;
    display: flex;
    justify-content: center;
    margin-bottom: 28px;
  }

  .spoiler-overlay {
    position: absolute;
    inset: -12px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    background: rgba(247, 248, 252, 0.7);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-2xl);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    cursor: pointer;
    font-family: inherit;
    transition:
      background var(--duration-normal) ease,
      border-color var(--duration-normal) ease,
      transform var(--duration-normal) var(--ease-out-expo);
  }

  .spoiler-overlay:hover {
    background: rgba(247, 248, 252, 0.85);
    border-color: var(--accent-color);
    transform: scale(1.01);
  }

  .spoiler-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-gradient-subtle);
    border: 1px solid rgba(91, 95, 230, 0.15);
    color: var(--accent-color);
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }

  .spoiler-overlay:hover .spoiler-icon { transform: scale(1.08); }

  .spoiler-text {
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .swatch-content.blurred {
    filter: blur(28px) saturate(0.15);
    user-select: none;
    pointer-events: none;
  }

  .answer-info.blurred {
    filter: blur(20px) saturate(0.15);
    user-select: none;
    pointer-events: none;
  }

  /* ── Color Swatch (large, prominent) ── */
  .color-swatch {
    width: 240px;
    height: 240px;
    border-radius: 28px;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-color);
    transition:
      transform 0.4s var(--ease-out-expo),
      box-shadow 0.4s ease;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .color-swatch:hover {
    transform: scale(1.03) translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .swatch-label {
    position: relative;
    z-index: 2;
    font-family: 'Outfit', 'DM Sans', sans-serif;
    font-size: 1.6rem;
    font-weight: 800;
    text-transform: capitalize;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  /* ── Answer Info ── */
  .answer-info {
    margin-bottom: 28px;
    transition: filter 0.5s var(--ease-out-expo);
  }

  .color-name {
    font-family: 'Outfit', 'DM Sans', sans-serif;
    font-size: 2rem;
    font-weight: 800;
    text-transform: capitalize;
    margin-bottom: 6px;
    letter-spacing: -0.02em;
  }

  .color-hex {
    font-family: 'JetBrains Mono', 'SF Mono', monospace;
    font-size: 1rem;
    color: var(--text-secondary);
    font-weight: 500;
    letter-spacing: 0.03em;
    cursor: pointer;
    padding: 4px 12px;
    border-radius: 6px;
    transition: background 0.2s ease, color 0.2s ease;
    display: inline-block;
  }

  .color-hex:hover {
    background: var(--bg-tertiary);
    color: var(--text-primary);
  }

  .copy-hint {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 6px;
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* ── Actions ── */
  .answer-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Error ── */
  .error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--text-secondary);
    padding: 28px 0;
  }

  .error-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(207, 34, 46, 0.08);
    color: var(--error);
  }

  /* ── Recent ── */
  .recent-section {
    max-width: 560px;
    margin: 48px auto 0;
  }

  .recent-title {
    font-family: 'Outfit', 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 14px;
    color: var(--text-secondary);
  }

  .recent-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .recent-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    transition: all 0.2s ease;
    text-decoration: none;
    color: inherit;
  }

  .recent-item:hover {
    border-color: var(--border-hover);
    box-shadow: var(--shadow-xs);
  }

  .recent-dot {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-xs);
  }

  .recent-dot .color-reflection {
    position: absolute;
    inset: 0;
    background: linear-gradient(170deg, rgba(255,255,255,0.3) 0%, transparent 45%);
    border-radius: 12px;
  }

  .recent-info { flex: 1; }

  .recent-name {
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: capitalize;
    letter-spacing: -0.01em;
  }

  .recent-date {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .recent-hex {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  /* ── SEO Content ── */
  .seo-content {
    max-width: 560px;
    margin: 56px auto 0;
  }

  .seo-content h2 {
    font-family: 'Outfit', 'DM Sans', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .seo-content p {
    font-size: 0.92rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .page-title { font-size: 2rem; }
    .answer-card { padding: 32px 20px; }
    .color-swatch { width: 200px; height: 200px; border-radius: 24px; }
    .color-name { font-size: 1.6rem; }
    .swatch-label { font-size: 1.3rem; }
  }

  @media (max-width: 640px) {
    .page-title { font-size: 1.7rem; }
    .color-swatch { width: 180px; height: 180px; border-radius: 22px; }
    .color-name { font-size: 1.4rem; }
    .swatch-label { font-size: 1.15rem; }
  }
</style>

<script define:vars={{ apiUrl, today }}>
  const dateDisplay = document.getElementById('dateDisplay');
  const loadingState = document.getElementById('loadingState');
  const answerState = document.getElementById('answerState');
  const errorState = document.getElementById('errorState');
  const dayNumber = document.getElementById('dayNumber');
  const colorSwatch = document.getElementById('colorSwatch');
  const swatchLabel = document.getElementById('swatchLabel');
  const colorName = document.getElementById('colorName');
  const colorHex = document.getElementById('colorHex');
  const recentList = document.getElementById('recentList');
  const spoilerOverlay = document.getElementById('spoilerOverlay');
  const swatchContent = document.getElementById('swatchContent');
  const answerInfo = document.getElementById('answerInfo');

  function isLightColor(hex) {
    const c = hex.replace('#', '');
    const r = parseInt(c.substring(0, 2), 16);
    const g = parseInt(c.substring(2, 4), 16);
    const b = parseInt(c.substring(4, 6), 16);
    return (r * 299 + g * 587 + b * 114) / 1000 > 160;
  }

  const now = new Date();
  dateDisplay.textContent = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

  // Spoiler reveal
  spoilerOverlay?.addEventListener('click', () => {
    spoilerOverlay.style.display = 'none';
    swatchContent.classList.remove('blurred');
    answerInfo.classList.remove('blurred');
    swatchContent.style.filter = 'none';
    answerInfo.style.filter = 'none';
  });

  // Copy hex code on click
  colorHex?.addEventListener('click', () => {
    const hex = colorHex.textContent;
    if (hex && navigator.clipboard) {
      navigator.clipboard.writeText(hex);
      const original = colorHex.textContent;
      colorHex.textContent = 'Copied!';
      setTimeout(() => { colorHex.textContent = original; }, 1200);
    }
  });

  async function loadAnswer() {
    try {
      const res = await fetch(`${apiUrl}/api/colordle/today`);
      if (!res.ok) throw new Error('Failed to fetch');
      const data = await res.json();

      loadingState.classList.add('hidden');
      answerState.classList.remove('hidden');

      dayNumber.textContent = `Day #${data.day_number}`;
      colorSwatch.style.background = data.color_hex || '#888';

      // Set swatch label color based on background
      const light = isLightColor(data.color_hex || '#888');
      swatchLabel.textContent = data.color_name;
      swatchLabel.style.color = light ? 'var(--text-primary)' : '#FFFFFF';
      swatchLabel.style.textShadow = light ? 'none' : '0 2px 8px rgba(0,0,0,0.2)';

      colorName.textContent = data.color_name;
      colorHex.textContent = data.color_hex || '';
    } catch (e) {
      loadingState.classList.add('hidden');
      errorState.classList.remove('hidden');
    }
  }

  async function loadRecent() {
    try {
      const to = today;
      const from = new Date(Date.now() - 7 * 86400000).toISOString().split('T')[0];
      const res = await fetch(`${apiUrl}/api/colordle/range?from=${from}&to=${to}`);
      if (!res.ok) return;
      const data = await res.json();

      recentList.innerHTML = data.slice(0, 7).map(item => `
        <div class="recent-item">
          <div class="recent-dot" style="background: ${item.color_hex || '#888'}">
            <div class="color-reflection"></div>
          </div>
          <div class="recent-info">
            <div class="recent-name">${item.color_name || 'Unknown'}</div>
            <div class="recent-date">${item.date} · Day #${item.day_number}</div>
          </div>
          <span class="recent-hex">${item.color_hex || ''}</span>
        </div>
      `).join('');
    } catch (e) {
      console.error(e);
    }
  }

  loadAnswer();
  loadRecent();
</script>
