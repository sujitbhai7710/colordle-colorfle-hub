---
import Layout from '../layouts/Layout.astro';

const apiUrl = import.meta.env.PUBLIC_API_URL || '';

// Fetch data at build time for the preview card
let colordleData: any = null;
let colorfleData: any = null;
let formattedDate = '';

try {
  const colordleRes = await fetch(`${apiUrl}/api/colordle/today`);
  if (colordleRes.ok) {
    colordleData = await colordleRes.json();
  }
} catch (e) {}

try {
  const colorfleRes = await fetch(`${apiUrl}/api/colorfle/today`);
  if (colorfleRes.ok) {
    colorfleData = await colorfleRes.json();
  }
} catch (e) {}

// Use the date from the API response (JST-based), not browser local time
const apiDate = colordleData?.date || colorfleData?.date;
if (apiDate) {
  const dateObj = new Date(apiDate + 'T00:00:00Z');
  formattedDate = dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
} else {
  // Fallback (shouldn't happen in production)
  const now = new Date();
  formattedDate = now.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

const faqData = [
  { question: "What is Colordle?", answer: "Colordle is a daily color guessing game where you try to identify a mystery color from a palette of 20 options. Each day brings a new color challenge, and you get six attempts to guess correctly. Think of it as Wordle, but for colors instead of words." },
  { question: "What is Colorfle?", answer: "Colorfle is a daily color mixing puzzle where you identify which three colors blend together to create a target shade. Normal mode uses 3 colors with specific weights, while hard mode adds a fourth color, making it significantly more challenging to decompose the blend." },
  { question: "How are the answers computed?", answer: "We use deterministic algorithms that exactly replicate the original game logic. This means our answers are mathematically verified solutions, not guesses or user submissions. We run automated verification multiple times per day to ensure accuracy." },
  { question: "When do the answers update?", answer: "Answers update multiple times throughout the day. Our system runs automated scrapes at regular intervals, then triggers a site rebuild so the latest answers are always available." },
  { question: "Can I look up past answers?", answer: "Yes! Our interactive archive covers every day since each game launched — March 2022 for Colordle and April 2022 for Colorfle. Use the calendar to navigate to any date and see the full answer details." },
  { question: "Is this site affiliated with Colordle or Colorfle?", answer: "No, we are an independent answer site. We are not affiliated with or endorsed by the creators of Colordle or Colorfle. We simply compute and display the daily answers using publicly available game algorithms." },
];
---


