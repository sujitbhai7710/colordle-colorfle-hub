---
import Layout from '../layouts/Layout.astro';

const apiUrl = import.meta.env.PUBLIC_API_URL || '';

// Fetch data at build time
let colorfleData: any = null;
let formattedDate = '';
let fetchError = false;

// Helper functions for server-side rendering
function isLightColor(hex: string): boolean {
  const c = hex.replace('#', '');
  const r = parseInt(c.substring(0, 2), 16);
  const g = parseInt(c.substring(2, 4), 16);
  const b = parseInt(c.substring(4, 6), 16);
  return (r * 299 + g * 587 + b * 114) / 1000 > 160;
}

function blendColors(colors: string[], weights: number[]): string {
  if (!colors.length) return '#888';
  const w = weights.length === colors.length ? weights : colors.map(() => 1 / colors.length);
  const totalWeight = w.reduce((a, b) => a + b, 0);
  let r = 0, g = 0, b = 0;
  colors.forEach((c, i) => {
    const hex = c.replace('#', '');
    const cr = parseInt(hex.substring(0, 2), 16);
    const cg = parseInt(hex.substring(2, 4), 16);
    const cb = parseInt(hex.substring(4, 6), 16);
    const wt = w[i] / totalWeight;
    r += cr * wt;
    g += cg * wt;
    b += cb * wt;
  });
  return `rgb(${Math.round(r)}, ${Math.round(g)}, ${Math.round(b)})`;
}

const NORMAL_WEIGHTS = [50, 34, 16];
const HARD_WEIGHTS = [40, 30, 20, 10];

let normalColors: string[] = [];
let hardColors: string[] = [];
let normalNames: string[] = [];
let hardNames: string[] = [];
let normalBlended = '';
let hardBlended = '';
let normalBlendedIsLight = false;
let hardBlendedIsLight = false;

try {
  const colorfleRes = await fetch(`${apiUrl}/api/colorfle/today`);
  if (colorfleRes.ok) {
    colorfleData = await colorfleRes.json();
    // Format date from API response
    const dateObj = new Date(colorfleData.date + 'T00:00:00Z');
    formattedDate = dateObj.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

    // Parse JSON arrays
    normalColors = JSON.parse(colorfleData.normal_answer || '[]');
    hardColors = JSON.parse(colorfleData.hard_answer || '[]');
    normalNames = JSON.parse(colorfleData.normal_names || '[]');
    hardNames = JSON.parse(colorfleData.hard_names || '[]');

    // Compute blended colors
    normalBlended = blendColors(normalColors, NORMAL_WEIGHTS);
    hardBlended = blendColors(hardColors, HARD_WEIGHTS);

    // Check if blended colors are light
    const normalBlendedHex = normalBlended.replace(/^rgb\((\d+),\s*(\d+),\s*(\d+)\)$/, (_, r, g, b) =>
      '#' + [r, g, b].map(x => parseInt(x).toString(16).padStart(2, '0')).join('')
    );
    const hardBlendedHex = hardBlended.replace(/^rgb\((\d+),\s*(\d+),\s*(\d+)\)$/, (_, r, g, b) =>
      '#' + [r, g, b].map(x => parseInt(x).toString(16).padStart(2, '0')).join('')
    );
    normalBlendedIsLight = isLightColor(normalBlendedHex);
    hardBlendedIsLight = isLightColor(hardBlendedHex);
  } else {
    fetchError = true;
  }
} catch (e) {
  fetchError = true;
}

const dayNumber = colorfleData?.day_number || '---';
---

<Layout title="Colorfle Answer Today - Daily Solutions & Color Mix Archive | Color Answers Hub" canonicalUrl="/colorfle-answer-today" description="Get today's Colorfle answer instantly! See the actual color blocks, blending weights, and mixed result for normal and hard mode. Updated daily with verified solutions.">
