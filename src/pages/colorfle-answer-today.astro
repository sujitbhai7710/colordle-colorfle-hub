              </div>

              <div class="answer-content blurred" id="answerContent">
                <!-- Mode Toggle -->
                <div class="mode-toggle">
                  <button class="mode-btn active" id="normalBtn">Normal</button>
                  <button class="mode-btn" id="hardBtn">Hard</button>
                </div>

                <!-- Normal Mode -->
                <div class="mode-section" id="normalSection">
                  <div class="section-label">Normal Mode — 3 Colors</div>
                  <div class="blocks-visual">
                    {normalColors.map((color, i) => (
                      <div class="color-block-item" style={`animation-delay: ${i * 0.1}s;`}>
                        <div class="color-block-swatch" style={`background: ${color};`}>
                          <div class="block-reflection"></div>
                          <span class="block-swatch-name" style={`color: ${isLightColor(color) ? 'var(--text-primary)' : '#FFFFFF'}; text-shadow: ${isLightColor(color) ? 'none' : '0 2px 6px rgba(0,0,0,0.2)'};`}>{normalNames[i] || color}</span>
                        </div>
